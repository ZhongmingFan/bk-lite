[[inputs.snmp]]
    startup_error_behavior = "retry"
    interval = "{{ interval }}s"
    {% if version == 2 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 2
    community = "{{ community }}"
    timeout = "{{ timeout }}s"
    {% elif version == 3 %}
    agents = ["udp://{{ ip }}:{{ port }}"]
    version = 3
    timeout = "{{ timeout }}s"
    sec_name = "{{ sec_name }}"
    sec_level = "{{ sec_level }}"
    auth_protocol = "{{ auth_protocol }}"
    auth_password = "${AUTH_PASSWORD__{{ config_id }}}"
    priv_protocol = "{{ priv_protocol }}"
    priv_password = "${PRIV_PASSWORD__{{ config_id }}}"
    {% else %}
    {% endif %}
    [inputs.snmp.tags]
        instance_id = "{{ instance_id }}"
        instance_type = "{{ instance_type }}"
        collect_type = "snmp_netonix"
        config_type = "netonix"
        brand = "netonix"
    # ---- System ----
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.3.0"
        name = "uptime"
    [[inputs.snmp.field]]
        oid = "1.3.6.1.2.1.1.5.0"
        name = "source"
        is_tag = true
    # ---- Interfaces (generic IF-MIB, auto-walked column names) ----
    [[inputs.snmp.table]]
        oid = "1.3.6.1.2.1.2.2"
        name = "interface"
        inherit_tags = ["source"]
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.2.2.1.2"
        name = "ifDescr"
        is_tag = true
    # ---- 64-bit IF-MIB HC traffic counters (ifXTable, wrap-safe on high-speed ports) ----
    # 待现网核验：ifHCInOctets 1.3.6.1.2.1.31.1.1.1.6 / ifHCOutOctets ...1.10，按 ifIndex 与上表接口行对齐。
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.6"
        name = "ifHCInOctets"
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.2.1.31.1.1.1.10"
        name = "ifHCOutOctets"
    # ---- Netonix 温度表（tempDescription / temp，°C，PEN 46242）----
    # tempDescription 1.3.6.1.4.1.46242.3.1.2 is_tag；temp 1.3.6.1.4.1.46242.3.1.3 Integer32 ℃。table.field 无 .0。
    [[inputs.snmp.table]]
        name = "device_temperature"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.3.1.2"
        name = "tempDescription"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.3.1.3"
        name = "celsius"
    # ---- Netonix 风扇转速（fanSpeed，RPM，INDEX fanIndex）----
    # fanSpeed 1.3.6.1.4.1.46242.2.1.2 Integer32 RPM。table.field 无 .0；行号即 fanIndex。
    [[inputs.snmp.table]]
        name = "device_fan"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.2.1.2"
        name = "speed"
    # ---- Netonix 电压表（voltageDescription / voltage，VoltageTC ÷100 → V）----
    # voltageDescription 1.3.6.1.4.1.46242.4.1.2 is_tag；voltage 1.3.6.1.4.1.46242.4.1.3。table.field 无 .0。
    [[inputs.snmp.table]]
        name = "device_voltage"
        inherit_tags = ["source"]
        index_as_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.4.1.2"
        name = "voltageDescription"
        is_tag = true
    [[inputs.snmp.table.field]]
        oid = "1.3.6.1.4.1.46242.4.1.3"
        name = "volts"
    # ---- Netonix 总功耗标量（totalPowerConsumption，PowerTC ÷10 → W）----
    # 1.3.6.1.4.1.46242.6.0，标量 field 带 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.6.0"
        name = "device_power_watts"
    # ---- Netonix DCDC 输入电流标量（dcdcInputCurrent，CurrentTC ÷10 → A，可选）----
    # 1.3.6.1.4.1.46242.7.0，标量 field 带 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.7.0"
        name = "device_dcdc_input_current"
    # ---- Netonix DCDC 效率标量（dcdcEfficiency，Integer32 %，可选）----
    # 1.3.6.1.4.1.46242.8.0，标量 field 带 .0。
    [[inputs.snmp.field]]
        oid = "1.3.6.1.4.1.46242.8.0"
        name = "device_dcdc_efficiency"
# ---- CPU/内存：无私有 CPU%/Mem% OID → N/A，不臆造。----
# ---- 本轮不采 PoE 口状态表。----

# VoltageTC ÷100 → V。仅处理 device_voltage，避免改动 IF-MIB 行。
[[processors.starlark]]
    namepass = ["device_voltage"]
    [processors.starlark.tagpass]
        brand = ["netonix"]
    source = '''
def apply(metric):
    raw = metric.fields.get("volts")
    if raw != None:
        metric.fields["volts"] = float(raw) / 100.0
    return metric
'''

# PowerTC ÷10 → W；CurrentTC ÷10 → A。仅缩放功耗/电流标量，uptime 不动。
[[processors.starlark]]
    namepass = ["snmp"]
    [processors.starlark.tagpass]
        brand = ["netonix"]
    source = '''
def apply(metric):
    raw = metric.fields.get("device_power_watts")
    if raw != None:
        metric.fields["device_power_watts"] = float(raw) / 10.0
    raw = metric.fields.get("device_dcdc_input_current")
    if raw != None:
        metric.fields["device_dcdc_input_current"] = float(raw) / 10.0
    return metric
'''
